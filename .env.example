# ==============================================================================
# NeuralFolk Environment Configuration
# ==============================================================================

# General
PROJECT_NAME=NeuralFolk
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# FastAPI Control Plane
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_me_in_production

# PostgreSQL Database (SQLAlchemy Async)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=neuralfolk
DATABASE_URL=postgresql+asyncpg://postgres:postgres@database:5432/neuralfolk

# Valkey (Broker, Cache, Streams)
VALKEY_HOST=cache
VALKEY_PORT=6379
VALKEY_URL=redis://cache:6379/0

# Celery Worker
CELERY_BROKER_URL=redis://cache:6379/0
CELERY_RESULT_BACKEND=redis://cache:6379/0

# Qdrant Vector DB
QDRANT_HOST=vector-db
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# FalkorDB Knowledge Graph DB
FALKORDB_HOST=graph-db
FALKORDB_PORT=6380

# Ollama Inference (Phase 1)
OLLAMA_HOST=http://inference:11434

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/events/ws
